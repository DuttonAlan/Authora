@page "/account/security"
@model Authora.Api.Pages.Account.SecurityModel
@{
    ViewData["Title"] = "Account and security";
}

<h1>Account and security</h1>
<p>Signed in as <strong>@Model.SignedInEmail</strong>.</p>

@if (Model.CanRequestEmailVerification)
{
    <partial name="_EmailVerificationNotice" />
}

<ul class="scopes">
    <li>
        <strong>This session</strong>
        <span class="description">Signed in on @Model.AuthenticatedAt.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC with @string.Join(" and ", Model.AuthenticationMethods).</span>
    </li>
    <li>
        <a href="/account/password">Change password</a>
        <span class="description">Signs you out everywhere else.</span>
    </li>
    <li>
        <strong>Two-step verification</strong>
        @if (Model.Mfa.AuthenticatorApp is { } authenticatorApp)
        {
            <span class="description">Authenticator app: on since @authenticatorApp.EnrolledAt.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture). You enter a code of the app after your password.</span>
            <span class="description">Recovery codes: @(Model.Mfa.RecoveryCodes?.Remaining ?? 0) of @(Model.Mfa.RecoveryCodes?.Total ?? 0) left.</span>
            <span class="description links"><a href="/account/security/recovery-codes">Recovery codes</a> <a href="/account/security/authenticator/remove">Remove authenticator app</a></span>
        }
        else
        {
            <span class="description">Authenticator app: off. Protect your account with a code from your phone in addition to your password.</span>
            <span class="description"><a href="/account/security/authenticator">Set up an authenticator app</a></span>
        }
        @if (Model.Mfa.Passkeys.Count > 0)
        {
            <span class="description">Passkeys: @Model.Mfa.Passkeys.Count registered. You can use one instead of a code after your password.</span>
            <span class="description"><a href="/account/security/passkeys">Manage passkeys</a></span>
        }
        else
        {
            <span class="description">Passkeys: none. A passkey on your phone, computer or a security key cannot be phished.</span>
            <span class="description"><a href="/account/security/passkeys">Add a passkey</a></span>
        }
        @foreach (var factor in Model.SecondFactors.Where(factor => factor.Method != Authora.Core.Domain.AuthenticationMethods.OneTimeCode
            && factor.Method != Authora.Core.Domain.AuthenticationMethods.HardwareKey))
        {
            <span class="description">@factor.DisplayName: @(factor.IsEnrolled ? "on" : "off")</span>
        }
    </li>
    @if (Model.ExternalAccounts.Linked.Count > 0 || Model.ExternalAccounts.Available.Count > 0)
    {
        <li>
            <a href="@Authora.Api.Pages.Account.ExternalAccountsModel.PagePath">Linked accounts</a>
            <span class="description">
                @(Model.ExternalAccounts.Linked.Count > 0
                    ? $"Sign in with {string.Join(", ", Model.ExternalAccounts.Linked.Select(account => account.ProviderName))}."
                    : "Sign in with an account at another provider.")
            </span>
        </li>
    }
    <li>
        <a href="/account/consents">Connected applications</a>
        <span class="description">Applications you allowed to access your account.</span>
    </li>
</ul>

<p class="muted"><a href="/account/logout">Sign out</a></p>

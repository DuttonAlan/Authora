@page "/account/forgot-password"
@model Authora.Api.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<h1>Forgot password</h1>

@if (Model.Sent)
{
    <p class="success" role="status">@Authora.Api.Pages.Account.ForgotPasswordModel.SentMessage</p>
    <p>The link works for @Model.LinkLifetime and only once. If no email arrives, check the address and your spam folder, or ask your administrator.</p>
    <p><a href="/account/login">Back to sign-in</a></p>
}
else
{
    <p>Enter the email address of your account. We send you a link to choose a new password.</p>

    @if (Model.ErrorMessage is not null)
    {
        <p class="error" role="alert">@Model.ErrorMessage</p>
    }

    <form method="post">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" autocomplete="username" required autofocus />

        <div class="actions">
            <button type="submit" class="primary">Send link</button>
        </div>
    </form>

    <p class="muted"><a href="/account/login">Back to sign-in</a></p>
}

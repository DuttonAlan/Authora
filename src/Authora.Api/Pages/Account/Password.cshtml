@page "/account/password"
@using Authora.Core.Application.Users.SetPassword
@model Authora.Api.Pages.Account.PasswordModel
@{
    ViewData["Title"] = Model.IsSettingPassword ? "Set a password" : "Change password";
}

@if (Model.Changed)
{
    <h1>@(Model.IsSettingPassword ? "Password set" : "Password changed")</h1>
    <p class="success" role="status">@(Model.IsSettingPassword ? "Your password was set. You can now sign in with it as well." : "Your password was changed.")</p>
    <p>You stay signed in here. Everywhere else you were signed out, and applications will ask you to sign in again.</p>

    @if (Model.SafeReturnUrl is not null)
    {
        <p><a href="@Model.SafeReturnUrl">Continue</a></p>
    }
}
else
{
    <h1>@(Model.IsSettingPassword ? "Set a password" : "Change password")</h1>
    <p>Signed in as <strong>@Model.SignedInEmail</strong>.</p>

    @if (Model.IsSettingPassword)
    {
        <p>You have no password yet and sign in with a linked account. With a password, you can also sign in without it.</p>
    }

    @if (Model.ErrorMessage is not null)
    {
        <p class="error" role="alert">@Model.ErrorMessage</p>
    }

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />

        @* The hidden Email lets password managers save the new password for the right account. *@
        <input type="email" name="username" value="@Model.SignedInEmail" autocomplete="username" hidden readonly />

        @if (!Model.IsSettingPassword)
        {
            <label asp-for="CurrentPassword">Current password</label>
            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required autofocus />
        }

        <label asp-for="NewPassword">New password</label>
        <input asp-for="NewPassword" type="password" autocomplete="new-password" required
               minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength" aria-describedby="new-password-hint" />
        <p class="muted hint" id="new-password-hint">@PasswordPolicy.MinLength to @PasswordPolicy.MaxLength characters. A few unrelated words make a strong password.</p>

        <label asp-for="ConfirmPassword">Repeat the new password</label>
        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
               minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength" />

        <p class="muted">Afterwards you are signed out everywhere else.</p>

        <div class="actions">
            <button type="submit" class="primary">@(Model.IsSettingPassword ? "Set password" : "Change password")</button>
        </div>
    </form>

    @if (Model.SafeReturnUrl is not null)
    {
        <p class="muted"><a href="@Model.SafeReturnUrl">Cancel</a></p>
    }
}

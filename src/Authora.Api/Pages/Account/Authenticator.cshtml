@page "/account/security/authenticator"
@model Authora.Api.Pages.Account.AuthenticatorModel
@{
    ViewData["Title"] = "Set up an authenticator app";
}

@if (Model.RecoveryCodes.Count > 0)
{
    <h1>Authenticator app set up</h1>
    <p class="success" role="status">From now on, you enter a code of the app after your password.</p>
    <p>If you lose your phone, sign in with one of these recovery codes instead. Each works once. Save them somewhere safe, e.g. in your password manager: they are not shown again.</p>

    <ul class="codes" aria-label="Recovery codes">
        @foreach (var code in Model.RecoveryCodes)
        {
            <li>@code</li>
        }
    </ul>

    <p><a href="@Model.ContinueUrl">@(Model.SafeReturnUrl is null ? "Done" : "Continue")</a></p>
}
else if (Model.AlreadyEnrolled)
{
    <h1>Authenticator app</h1>
    <p>An authenticator app is already set up. To use another one, remove it first, then set up the new one.</p>
    <p class="links"><a href="/account/security/authenticator/remove">Remove authenticator app</a> <a href="@Model.ContinueUrl">@(Model.SafeReturnUrl is null ? "Back" : "Continue")</a></p>
}
else
{
    <h1>Set up an authenticator app</h1>

    @if (Model.SafeReturnUrl is not null)
    {
        <p><strong>To continue, your account needs a second step after the password.</strong></p>
        <p>Set up an authenticator app below, or <a href="/account/security/passkeys?returnUrl=@Uri.EscapeDataString(Model.SafeReturnUrl)">add a passkey</a> instead.</p>
    }

    @if (Model.ErrorMessage is not null)
    {
        <p class="error" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.Enrollment is not null)
    {
        <p>Scan this QR code with an authenticator app, e.g. the one of your password manager.</p>

        <svg class="qr" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 @Model.QrCodeSize @Model.QrCodeSize" shape-rendering="crispEdges" role="img" aria-label="QR code with the secret for your authenticator app">
            <rect width="@Model.QrCodeSize" height="@Model.QrCodeSize" fill="#ffffff" />
            <path d="@Model.QrCodePath" fill="#000000" />
        </svg>

        <p class="muted">Cannot scan it? Enter this key in the app, as a time-based key:</p>
        <code class="secret">@Model.Enrollment.Secret</code>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <label asp-for="Code">Code from the app</label>
            <input asp-for="Code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="32" required autofocus />

            <div class="actions">
                <button type="submit" class="primary">Turn on</button>
            </div>
        </form>
    }

    <p class="muted"><a href="/account/security">Cancel</a></p>
}

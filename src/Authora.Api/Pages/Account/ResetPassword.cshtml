@page "/account/reset-password"
@using Authora.Core.Application.Account
@using Authora.Core.Application.Users.SetPassword
@model Authora.Api.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
}

@if (Model.Reset)
{
    <h1>Password set</h1>
    <p class="success" role="status">Your new password is set.</p>
    <p>You were signed out everywhere, and applications will ask you to sign in again.</p>
    <p><a href="/account/login">Sign in</a></p>
}
else
{
    <h1>Choose a new password</h1>

    @if (Model.ErrorMessage is not null)
    {
        <p class="error" role="alert">@Model.ErrorMessage</p>
    }

    @if (Model.IsValidLink)
    {
        @* Posted to the page without the token in the URL; the hidden field carries it. *@
        <form method="post" action="@PasswordResetLink.PagePath" asp-antiforgery="true">
            <input type="hidden" name="@PasswordResetLink.TokenParameter" value="@Model.Token" />

            <label asp-for="NewPassword">New password</label>
            <input asp-for="NewPassword" type="password" autocomplete="new-password" required autofocus
                   minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength" aria-describedby="new-password-hint" />
            <p class="muted hint" id="new-password-hint">@PasswordPolicy.MinLength to @PasswordPolicy.MaxLength characters. A few unrelated words make a strong password.</p>

            <label asp-for="ConfirmPassword">Repeat the new password</label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required
                   minlength="@PasswordPolicy.MinLength" maxlength="@PasswordPolicy.MaxLength" />

            <p class="muted">Afterwards you are signed out everywhere.</p>

            <div class="actions">
                <button type="submit" class="primary">Set password</button>
            </div>
        </form>
    }
    else if (Model.CanRequestNewLink)
    {
        <p><a href="/account/forgot-password">Request a new link</a></p>
    }
    else
    {
        <p>Ask your administrator for a new link.</p>
    }

    <p class="muted"><a href="/account/login">Back to sign-in</a></p>
}

@page "/account/external/{slug}/callback"
@model Authora.Api.Pages.Account.ExternalCallbackModel
@using Authora.Core.Application.ExternalSignIn.Complete
@{
    ViewData["Title"] = "Sign in";
}

@section Head {
    @if (Model.Status == ExternalSignInStatus.Pending)
    {
        @* A navigation of this page, so the browser sends the SameSite=Strict cookie of the pending sign-in. *@
        <meta http-equiv="refresh" content="0;url=@Model.ContinueUrl" />
    }
}

@if (Model.Status == ExternalSignInStatus.Pending)
{
    <h1>Two-step verification</h1>
    <p>You signed in with @Model.ProviderName. Confirm it is you with your second factor.</p>
    <p><a href="@Model.ContinueUrl">Continue</a></p>
}
else if (Model.Status == ExternalSignInStatus.NotLinked)
{
    <h1>Account not linked</h1>
    <p class="error" role="alert">@ExternalCallbackModel.NotLinkedMessage</p>
    <p class="muted">After signing in, link your @Model.ProviderName account under "Account and security".</p>
    <p><a href="@Model.ContinueUrl">Sign in with your password</a></p>
}
else if (Model.Status == ExternalSignInStatus.LinkConflict)
{
    <h1>Account not linked</h1>
    <p class="error" role="alert">@ExternalCallbackModel.LinkConflictMessage</p>
    <p><a href="@Model.ContinueUrl">Back</a></p>
}
else
{
    <h1>Sign in</h1>
    <p class="error" role="alert">@ExternalCallbackModel.FailedMessage</p>
    <p><a href="@Model.ContinueUrl">Back</a></p>
}

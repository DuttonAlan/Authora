# Copy to .env and fill in. Used by docker-compose.yml for local evaluation only.

# Password of the PostgreSQL user "authora".
POSTGRES_PASSWORD=

# The first administrator, created on the first start. The password must be 12 to 128 characters long.
# Remove AUTHORA_ADMIN_PASSWORD once you have signed in and set a new password.
AUTHORA_ADMIN_EMAIL=admin@example.com
AUTHORA_ADMIN_PASSWORD=
